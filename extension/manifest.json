{
  "manifest_version": 3,
  "name": "NCP Tab Renamer",
  "version": "1.3",
  "description": "네이버 클라우드 콘솔의 URL을 기반으로 브라우저 탭 이름을 서비스명으로 자동 변경하는 Chrome 확장 프로그램입니다.",
  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "webNavigation"
  ],
  "host_permissions": [
    "https://console.ncloud.com/*",
    "https://console.fin-ncloud.com/*",
    "https://console.gov-ncloud.com/*"
  ],
  "icons": {
    "128": "icons.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://console.ncloud.com/*",
        "https://console.fin-ncloud.com/*",
        "https://console.gov-ncloud.com/*"
      ],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_title": "NCP Tab Renamer",
    "default_popup": "popup.html"
  }
}
